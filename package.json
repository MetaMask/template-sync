{
  "name": "@metamask/template-sync",
  "version": "1.1.0",
  "description": "Synchronise a Git repository with the MetaMask module template repository.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/template-sync.git"
  },
  "license": "MIT",
  "author": "Maarten Zuidhoorn <maarten@zuidhoorn.com>",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:clean": "rimraf dist && yarn build",
    "build:docs": "typedoc",
    "lint": "yarn lint:eslint && yarn lint:misc --check && yarn lint:dependencies --check && yarn lint:changelog",
    "lint:changelog": "auto-changelog validate",
    "lint:dependencies": "depcheck && yarn dedupe",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write && yarn lint:dependencies && yarn lint:changelog",
    "lint:misc": "prettier '**/*.json' '**/*.md' '!CHANGELOG.md' '**/*.yml' '!.yarnrc.yml' --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "prepack": "./scripts/prepack.sh",
    "test": "jest --passWithNoTests && jest-it-up",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@metamask/utils": "^5.0.1",
    "chalk": "^4.1.2",
    "execa": "^5.1.1",
    "inquirer": "^8.2.3",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "semver": "^7.5.0",
    "yargs": "^17.7.1"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^2.5.1",
    "@lavamoat/preinstall-always-fail": "^1.0.0",
    "@metamask/auto-changelog": "^3.1.0",
    "@metamask/eslint-config": "^14.0.0",
    "@metamask/eslint-config-jest": "^14.0.0",
    "@metamask/eslint-config-nodejs": "^14.0.0",
    "@metamask/eslint-config-typescript": "^14.0.0",
    "@types/inquirer": "^9.0.3",
    "@types/jest": "^28.1.6",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^18.15.13",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "depcheck": "^1.4.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-n": "^17.20.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^7.1.0",
    "jest": "^28.1.3",
    "jest-it-up": "^2.0.2",
    "prettier": "^3.2.5",
    "prettier-plugin-packagejson": "^2.5.15",
    "rimraf": "^3.0.2",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.7.0",
    "typedoc": "^0.23.15",
    "typescript": "~4.8.4",
    "typescript-eslint": "^8.35.0"
  },
  "packageManager": "yarn@3.5.0",
  "engines": {
    "node": "^18.20 || ^20.17 || >=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "eslint-plugin-import-x>unrs-resolver": false
    }
  }
}
